# ==============================================================================
# Multi-Agent AI Orchestration System - Environment Configuration
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL 15+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_orchestrator
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agent_orchestrator
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/agent_orchestrator

# Redis & Celery Message Broker (Redis 7+)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM Provider (Groq / LangChain)
LLM_API_KEY=your_llm_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External Custom Tool APIs
# Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# OpenWeatherMap API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# API & Security
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
